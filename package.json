{
  "name": "tamy",
  "version": "1.0.0",
  "private": true,
  "description": "TAMY — تطبيق أذكار ومواقيت صلاة وقبلة",
  "scripts": {
    "fonts": "node scripts/copy-fonts.js",
    "android:add": "cap add android",
    "assets": "capacitor-assets generate --android --assetPath assets",
    "android:prepare": "node scripts/prepare-android.js",
    "sync": "npm run audio && cap sync android && npm run android:prepare",
    "apk": "cd android && ./gradlew assembleDebug",
    "quran": "node scripts/fetch-quran.js",
    "audio": "node scripts/prepare-audio.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capgo/capacitor-updater": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@fontsource/amiri": "^5.0.0",
    "@fontsource/amiri-quran": "^5.0.0",
    "@fontsource/cairo": "^5.0.0",
    "quran-json": "^3.1.2"
  }
}
